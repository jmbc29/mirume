{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mirume",
  "version": "0.1.0",
  "identifier": "com.mirume.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mirume",
        "width": 1440,
        "height": 900,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "card",
        "title": "Mirume Card",
        "width": 356,
        "height": 396,
        "transparent": true,
        "decorations": false,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
